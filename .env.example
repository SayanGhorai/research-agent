# ResearchLens AI — environment variable template
# Copy this file to .env and fill in your values.
# Never commit a populated .env file.

# IBM watsonx.ai credentials (owner supplies privately)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# Generation gate: set true only after live smoke test passes
ALLOW_LIVE_GENERATION=false

# Optional simple access password for public preview
APP_ACCESS_PASSWORD=

# Crossref polite-pool email (recommended, not required)
CROSSREF_MAILTO=

# Application environment: local | staging | production
APP_ENV=local

# Feature flags and limits
ENABLE_SEMANTIC_SEARCH=true
MAX_LLM_CALLS_PER_ACTION=3
MAX_OUTPUT_TOKENS=900
MAX_UPLOAD_MB=10
MAX_PDFS_PER_SESSION=3
MAX_PAGES_PER_PDF=40
